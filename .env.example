# Required Discord application values
DISCORD_TOKEN=replace-with-your-bot-token
DISCORD_CLIENT_ID=replace-with-your-application-id

# Set this while developing so commands appear immediately in one server.
# Leave empty for global command deployment (global commands can take up to an hour).
DISCORD_GUILD_ID=replace-with-your-test-server-id

# Optional. Defaults to ./data/bot.json.
DATA_FILE=./data/bot.json

# Optional display settings.
BOT_NAME=Chud Eats
BOT_COLOR=#e11d48
# Optional. Use a hosted image URL for a branded panel banner.
BRAND_BANNER_URL=
# Optional local path. Defaults to assets/chud-eats-banner.png.
BRAND_BANNER_PATH=./assets/chud-eats-banner.png
